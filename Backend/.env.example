# ==========================================
# SmartInspect Backend Environment Variables
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL="postgresql://username:password@localhost:5432/smartinspect?schema=public"

# Redis Configuration (Caching & Task Queue)
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Frontend / Client Origin (CORS)
CLIENT_URL=http://localhost:5173

# Cloudinary (Media & Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Service Microservice URL
# AI_SERVICE_URL=http://localhost:8000
